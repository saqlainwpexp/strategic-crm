// Strategic CRM — Prisma schema (MySQL / Hostinger)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  SALES
  BD
  MANAGER
  SUPER_ADMIN
}

enum PipelineStage {
  LEAD
  CONTACTED
  INTERESTED
  MEETING_BOOKED
  SHOWED
  NO_SHOW
  NOT_INTERESTED
  HUNG_UP
  CALL_ME_LATER
  CLOSED_WON // Signed Up Client
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum MeetingType {
  DISCOVERY
  FOLLOW_UP
  PROPOSAL
  ONBOARDING
}

enum CallDisposition {
  CONNECTED
  NO_ANSWER
  VOICEMAIL
  BUSY
  WRONG_NUMBER
  INTERESTED
  NOT_INTERESTED
  CALL_ME_LATER
  MEETING_BOOKED
  HUNG_UP
}

enum MeetingStatus {
  BOOKED
  SHOWED
  NO_SHOW
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
  URL
}

// ─────────────────────────── Core ────────────────────────────

model User {
  agencyId String @default("default")
  @@index([agencyId])
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(SALES)
  title        String  @default("")
  active       Boolean @default(true)
  avatarUrl    String?

  // Login security: lock the account briefly after repeated failed sign-ins.
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  // Hierarchy: Sales -> BD -> Manager
  reportsToId String?
  reportsTo   User?   @relation("Reports", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     User[]  @relation("Reports")

  leads     Lead[]      @relation("AssignedLeads")
  calls     CallLog[]
  meetings  Meeting[]
  payments  Payment[]
  timeLogs  TimeLog[]
  uploads   CsvImport[]
  auditLogs AuditLog[]
  scripts   Script[]
  campaigns Campaign[]
  outreachThreads    OutreachThread[]
  outreachActivities OutreachActivity[]
  outreachTemplates  OutreachTemplate[]
  socialAccounts     SocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportsToId])
  @@index([role])

}

model Pool {
  agencyId String @default("default")
  @@index([agencyId])
  id          String   @id @default(cuid())
  name        String   
  description String?  @db.Text
  leads       Lead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([agencyId, name])
}

model Lead {
  agencyId String @default("default")
  @@index([agencyId])
  id                String        @id @default(cuid())
  businessName      String
  address           String?       @db.Text
  website           String?
  issues            String?       @db.Text
  suggestedServices String?       @db.Text
  phone             String?
  email             String?
  priority          LeadPriority  @default(MEDIUM)
  source            String?
  decisionMakerName String?
  city              String?
  leadScore         Int           @default(0) // 0-100; Cold/Warm/Hot is derived using Setting thresholds
  stage             PipelineStage @default(LEAD)
  service           String        @default("Web Design") // Web Design / Graphic Design / GHL
  estimatedValue    Decimal       @default(0) @db.Decimal(12, 2)
  notes             String?       @db.Text
  customFields      Json? // admin-defined extra fields, keyed by CustomFieldDef.key

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  poolId String?
  pool   Pool?   @relation(fields: [poolId], references: [id], onDelete: SetNull)

  calls    CallLog[]
  meetings Meeting[]
  payments Payment[]

  // Email marketing — leads double as email contacts.
  tags           Json? // string[] used to group contacts for campaigns and automations
  emailOptOut    Boolean                @default(false) // unsubscribed: never sent marketing email again
  unsubscribedAt DateTime?
  emailBouncedAt DateTime?
  lastEmailedAt  DateTime?
  handedOffAt    DateTime? // sent from email outreach to the calling team
  emailSends     EmailSend[]
  enrollments    AutomationEnrollment[]
  inboxThreads   InboxThread[]

  // Social DM outreach (LinkedIn, Facebook, Instagram, Threads, …). Company = businessName,
  // contact person = decisionMakerName, lead source = source.
  jobTitle         String?
  industry         String?
  location         String?
  connectionDegree String? @db.VarChar(8) // 1st | 2nd | 3rd
  followerCount    Int?
  primaryChannel   String? @db.VarChar(20) // a platform id, "phone" or "email"
  socialProfiles   LeadSocialProfile[]
  outreachThreads  OutreachThread[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  closedAt        DateTime? // when the lead became a signed client

  @@index([assignedToId])
  @@index([poolId])
  @@index([stage])
  @@index([leadScore])
  @@index([priority])
  @@index([nextFollowUpAt])
  @@index([phone])
  @@index([email])

}

model CallLog {
  agencyId String @default("default")
  @@index([agencyId])
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime         @default(now())
  endedAt     DateTime?
  durationSec Int              @default(0)
  disposition CallDisposition?
  scriptId    String?
  script      Script?          @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([startedAt])

}

model Script {
  agencyId String @default("default")
  @@index([agencyId])
  id          String    @id @default(cuid())
  title       String
  category    String?
  body        String    @db.Text
  active      Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  calls       CallLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

}

model Meeting {
  agencyId String @default("default")
  @@index([agencyId])
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        MeetingType   @default(DISCOVERY)
  scheduledAt DateTime
  durationMin Int           @default(30)
  status      MeetingStatus @default(BOOKED)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([scheduledAt])

}

model Payment {
  agencyId String @default("default")
  @@index([agencyId])
  id        String        @id @default(cuid())
  invoiceNo String        
  leadId    String
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   String // Web Design / Graphic Design / GHL
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("PKR")
  status    PaymentStatus @default(PENDING)
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@unique([agencyId, invoiceNo])
}

model TimeLog {
  agencyId String @default("default")
  @@index([agencyId])
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn     DateTime  @default(now())
  clockOut    DateTime?
  durationSec Int       @default(0)

  @@index([userId])
  @@index([clockIn])

}

model CustomFieldDef {
  agencyId String @default("default")
  @@index([agencyId])
  id        String          @id @default(cuid())
  name      String // display label
  key       String           // machine key used in Lead.customFields
  type      CustomFieldType @default(TEXT)
  options   Json? // for SELECT
  required  Boolean         @default(false)
  order     Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  @@unique([agencyId, key])
}

model CsvImport {
  agencyId String @default("default")
  @@index([agencyId])
  id             String   @id @default(cuid())
  fileName       String
  rowCount       Int      @default(0)
  successCount   Int      @default(0)
  duplicateCount Int      @default(0)
  errorCount     Int      @default(0)
  poolId         String?
  status         String   @default("completed")
  mapping        Json?
  errors         Json?
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

}

model AuditLog {
  agencyId String @default("default")
  @@index([agencyId])
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])

}

model Setting {
  agencyId String @default("default")
  @@index([agencyId])
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  @@id([agencyId, key])
}

// ─────────────────────── Email marketing ──────────────────────

enum EmailAccountStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  SENT
  CANCELLED
}

enum SendStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

enum MessageDirection {
  IN
  OUT
}

/// A mailbox we send from (SMTP) and read replies from (IMAP). The password is AES-GCM encrypted.
model EmailAccount {
  agencyId String @default("default")
  @@index([agencyId])
  id          String             @id @default(cuid())
  name        String
  email       String             
  fromName    String
  provider    String             @default("Custom")
  smtpHost    String
  smtpPort    Int                @default(465)
  smtpSecure  Boolean            @default(true)
  smtpUser    String
  passwordEnc String             @db.Text
  imapEnabled Boolean            @default(true)
  imapHost    String             @default("")
  imapPort    Int                @default(993)
  imapSecure  Boolean            @default(true)
  dailyLimit  Int                @default(150)
  minDelaySec Int                @default(60) // gap between two sends from this mailbox
  signature   String             @default("") @db.Text
  status      EmailAccountStatus @default(PENDING)
  lastError   String?            @db.Text
  sentToday   Int                @default(0)
  sentDay     String             @default("") // YYYY-MM-DD the counter belongs to
  lastSentAt  DateTime?
  lastSyncAt  DateTime?
  lastUid     Int                @default(0) // highest IMAP UID already imported
  uidValidity String?
  sends       EmailSend[]
  threads     InboxThread[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@unique([agencyId, email])
}

model EmailDomain {
  agencyId String @default("default")
  @@index([agencyId])
  id            String    @id @default(cuid())
  domain        String    
  spfStatus     String    @default("pending")
  dkimStatus    String    @default("pending")
  dmarcStatus   String    @default("pending")
  details       Json?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  @@unique([agencyId, domain])
}

model EmailTemplate {
  agencyId String @default("default")
  @@index([agencyId])
  id        String   @id @default(cuid())
  name      String
  subject   String   @default("")
  html      String   @db.MediumText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Campaign {
  agencyId String @default("default")
  @@index([agencyId])
  id             String         @id @default(cuid())
  name           String
  subject        String         @default("")
  previewText    String         @default("")
  html           String         @db.MediumText
  fromName       String         @default("")
  replyTo        String         @default("")
  accountIds     Json // string[] — sends rotate across these mailboxes
  audience       Json // AudienceFilter (see src/lib/email.ts)
  trackOpens     Boolean        @default(true)
  trackClicks    Boolean        @default(true)
  addUnsubscribe Boolean        @default(true)
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  recipientCount Int            @default(0)
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sends          EmailSend[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])

}

/// One outgoing email (a campaign recipient or an automation step) and what happened to it.
model EmailSend {
  agencyId String @default("default")
  @@index([agencyId])
  id           String        @id @default(cuid())
  campaignId   String?
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  automationId String?
  automation   Automation?   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  stepIndex    Int?
  nodeId       String?
  leadId       String?
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  email        String
  accountId    String?
  account      EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status       SendStatus    @default(QUEUED)
  subject      String        @default("") @db.VarChar(500)
  messageId    String?       @db.VarChar(255)
  error        String?       @db.Text
  claimedAt    DateTime?
  queuedAt     DateTime      @default(now())
  sentAt       DateTime?
  openedAt     DateTime?
  openCount    Int           @default(0)
  clickedAt    DateTime?
  clickCount   Int           @default(0)
  repliedAt    DateTime?
  bouncedAt    DateTime?

  @@unique([campaignId, leadId])
  @@index([status, queuedAt])
  @@index([leadId])
  @@index([automationId])
  @@index([sentAt])
  @@index([messageId])

}

model Automation {
  agencyId String @default("default")
  @@index([agencyId])
  id           String                 @id @default(cuid())
  name         String
  trigger      String                 @default("MANUAL") // MANUAL | LEAD_CREATED | STAGE_CHANGED | TAG_ADDED
  triggerValue String                 @default("")
  flow         Json                   @map("steps") // Flow graph (see src/lib/automation-flow.ts)
  accountIds   Json // string[]
  stopOnReply  Boolean                @default(true)
  status       AutomationStatus       @default(DRAFT)
  enrollments  AutomationEnrollment[]
  sends        EmailSend[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

}

model AutomationEnrollment {
  agencyId String @default("default")
  @@index([agencyId])
  id           String           @id @default(cuid())
  automationId String
  automation   Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepIndex    Int              @default(0)
  nodeId       String? // workflow node to run next (null = first step after the trigger)
  nextRunAt    DateTime?
  status       EnrollmentStatus @default(ACTIVE)
  stopReason   String?
  enrolledAt   DateTime         @default(now())
  finishedAt   DateTime?

  @@unique([automationId, leadId])
  @@index([status, nextRunAt])

}

model InboxThread {
  agencyId String @default("default")
  @@index([agencyId])
  id            String         @id @default(cuid())
  accountId     String
  account       EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  subject       String         @db.VarChar(500)
  contactEmail  String
  contactName   String         @default("")
  unread        Boolean        @default(true)
  archived      Boolean        @default(false)
  lastMessageAt DateTime
  messages      InboxMessage[]
  createdAt     DateTime       @default(now())

  @@index([accountId, lastMessageAt])
  @@index([contactEmail])

}

model InboxMessage {
  agencyId String @default("default")
  @@index([agencyId])
  id         String           @id @default(cuid())
  threadId   String
  thread     InboxThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  accountId  String
  messageId  String           @db.VarChar(255)
  inReplyTo  String?          @db.VarChar(255)
  references String?          @db.Text
  direction  MessageDirection
  fromEmail  String
  fromName   String           @default("")
  toEmail    String           @default("")
  subject    String           @db.VarChar(500)
  text       String           @db.MediumText
  sentAt     DateTime
  createdAt  DateTime         @default(now())

  @@unique([accountId, messageId])
  @@index([threadId, sentAt])

}

// ─────────────────────── LinkedIn automation ──────────────────

enum LiAccountStatus {
  WARMING
  ACTIVE
  PAUSED
  RESTRICTED
}

enum LiCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum LiProspectState {
  QUEUED
  INVITED
  CONNECTED
  REPLIED
  DONE
  FAILED
  SKIPPED
}

enum LiActionType {
  VIEW_PROFILE
  CONNECT
  MESSAGE
  FOLLOW_UP
  WITHDRAW
  SYNC_INBOX
}

enum LiActionStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum LiConvLabel {
  INTERESTED
  NOT_NOW
  NOT_INTERESTED
  WRONG_PERSON
}

/// A LinkedIn sender account with its own proxy and browser profile.
model LiAccount {
  agencyId String @default("default")
  @@index([agencyId])
  id                 String          @id @default(cuid())
  name               String
  ownerName          String          @default("")
  linkedinEmail      String          @default("")
  proxyServer        String          @default("")
  proxyUser          String          @default("")
  proxyPassEnc       String          @default("") @db.Text
  profilePath        String          @default("")
  /// LinkedIn cookies sent by the CRM browser extension (encrypted JSON).
  sessionEnc         String          @default("") @db.Text
  sessionUserAgent   String          @default("") @db.VarChar(500)
  sessionSyncedAt    DateTime?
  timezone           String          @default("America/New_York")
  locale             String          @default("en-US")
  status             LiAccountStatus @default(WARMING)
  warmupWeeks        Int             @default(0)
  maxDailyConnects   Int             @default(10)
  maxDailyMessages   Int             @default(20)
  maxDailyViews      Int             @default(30)
  connectsThisWeek   Int             @default(0)
  connectsWindowStart DateTime?
  connectsToday      Int             @default(0)
  messagesToday      Int             @default(0)
  viewsToday         Int             @default(0)
  actionDay          String          @default("")
  lastActionAt       DateTime?
  lastSyncAt         DateTime?
  lastError          String?         @db.Text
  notes              String?         @db.Text
  actions            LiAction[]
  campaignProspects  LiCampaignProspect[]
  conversations      LiConversation[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])

}

/// A LinkedIn prospect (potential outreach target).
model LiProspect {
  agencyId String @default("default")
  @@index([agencyId])
  id           String   @id @default(cuid())
  linkedinUrl  String   
  firstName    String   @default("")
  lastName     String   @default("")
  title        String   @default("")
  company      String   @default("")
  location     String   @default("")
  tags         Json?
  source       String   @default("manual")
  notes        String?  @db.Text
  campaignProspects LiCampaignProspect[]
  actions      LiAction[]
  conversations LiConversation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([company])
  @@unique([agencyId, linkedinUrl])
}

/// Reusable LinkedIn message template with {firstName}, {company} placeholders.
model LiTemplate {
  agencyId String @default("default")
  @@index([agencyId])
  id        String   @id @default(cuid())
  name      String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

/// A LinkedIn outreach campaign (sequence of steps sent by chosen accounts).
model LiCampaign {
  agencyId String @default("default")
  @@index([agencyId])
  id               String           @id @default(cuid())
  name             String
  status           LiCampaignStatus @default(DRAFT)
  steps            Json
  senderAccountIds Json
  startDate        DateTime?
  prospects        LiCampaignProspect[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])

}

/// Where each prospect is in a campaign (one account owns them for the whole sequence).
model LiCampaignProspect {
  agencyId String @default("default")
  @@index([agencyId])
  id           String          @id @default(cuid())
  campaignId   String
  campaign     LiCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospectId   String
  prospect     LiProspect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  accountId    String
  account      LiAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stepIndex    Int             @default(0)
  nextActionAt DateTime?
  state        LiProspectState @default(QUEUED)
  failReason   String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([campaignId, prospectId])
  @@index([accountId, nextActionAt])
  @@index([state])

}

/// Full log of every action the worker performed (or tried to perform).
model LiAction {
  agencyId String @default("default")
  @@index([agencyId])
  id             String         @id @default(cuid())
  accountId      String
  account        LiAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  prospectId     String?
  prospect       LiProspect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  type           LiActionType
  status         LiActionStatus @default(PENDING)
  dryRun         Boolean        @default(true)
  error          String?        @db.Text
  screenshotPath String?
  createdAt      DateTime       @default(now())

  @@index([accountId, type, createdAt])
  @@index([prospectId])

}

/// One LinkedIn conversation thread (one per lead per account).
model LiConversation {
  agencyId String @default("default")
  @@index([agencyId])
  id              String          @id @default(cuid())
  accountId       String
  account         LiAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  prospectId      String?
  prospect        LiProspect?     @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  threadUrl       String          @default("") @db.VarChar(500)
  label           LiConvLabel?
  unread          Boolean         @default(true)
  stoppedByReply  Boolean         @default(false)
  lastMessageAt   DateTime
  messages        LiMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([accountId, lastMessageAt])

}

model LiMessage {
  agencyId String @default("default")
  @@index([agencyId])
  id             String           @id @default(cuid())
  conversationId String
  conversation   LiConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  text           String           @db.Text
  sentAt         DateTime
  /// Reply typed in the CRM inbox that the local worker still has to send on LinkedIn.
  pendingSend    Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([conversationId, sentAt])

}

model Agency {
  id String @id @default(cuid())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
}

model SignupLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

// ─────────────────────── Social outreach ──────────────────────
// Manual DM tracking. Platforms are plain ids from src/lib/outreach/platforms.ts so a new
// network needs no migration.

enum OutreachStage {
  not_contacted
  connection_sent
  connected
  message_sent
  replied
  interested
  call_booked
  won
  lost
  not_interested
  no_response
}

enum ReplySentiment {
  positive
  neutral
  negative
  objection
}

enum OutreachDirection {
  outbound
  inbound
}

enum OutreachActivityType {
  connection_request
  dm
  comment
  like
  story_reply
  voice_note
}

/// One social profile of a lead. `key` is the normalised URL/handle used for duplicate checks.
model LeadSocialProfile {
  agencyId  String   @default("default")
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  platform  String   @db.VarChar(20)
  url       String   @db.VarChar(500)
  key       String   @db.VarChar(300)
  createdAt DateTime @default(now())

  @@unique([agencyId, platform, key])
  @@unique([agencyId, leadId, platform])
  @@index([agencyId])
  @@index([leadId])
}

model OutreachThread {
  agencyId             String          @default("default")
  id                   String          @id @default(cuid())
  leadId               String
  lead                 Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId              String?
  owner                User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  platform             String          @db.VarChar(20)
  threadUrl            String?         @db.VarChar(500)
  stage                OutreachStage   @default(not_contacted)
  connectionSentAt     DateTime?
  connectionAcceptedAt DateTime?
  firstMessageAt       DateTime?
  lastOutboundAt       DateTime?
  lastInboundAt        DateTime?
  followupCount        Int             @default(0)
  nextFollowupAt       DateTime?
  replySentiment       ReplySentiment?
  templateId           String?
  template             OutreachTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaignId           String?
  campaign             OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  notes                String?         @db.Text
  activities           OutreachActivity[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([agencyId, leadId, platform])
  @@index([agencyId])
  @@index([ownerId])
  @@index([stage])
  @@index([nextFollowupAt])
  @@index([campaignId])
}

model OutreachActivity {
  agencyId    String               @default("default")
  id          String               @id @default(cuid())
  threadId    String
  thread      OutreachThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    String               @db.VarChar(20) // copied from the thread for fast daily counts
  direction   OutreachDirection
  type        OutreachActivityType
  messageText String?              @db.Text
  occurredAt  DateTime             @default(now())

  @@index([agencyId])
  @@index([threadId])
  @@index([userId, platform, occurredAt])
  @@index([occurredAt])
}

model OutreachTemplate {
  agencyId    String             @default("default")
  id          String             @id @default(cuid())
  name        String
  platform    String             @db.VarChar(20) // a platform id or "any"
  body        String             @db.Text // supports {first_name} {company} {job_title}
  active      Boolean            @default(true)
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  threads     OutreachThread[]
  campaigns   OutreachCampaign[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([agencyId])
}

model OutreachCampaign {
  agencyId   String            @default("default")
  id         String            @id @default(cuid())
  name       String
  platform   String            @db.VarChar(20)
  audience   String?           @db.Text
  templateId String?
  template   OutreachTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  startDate  DateTime?
  dailyLimit Int?
  goal       String?           @db.Text
  status     String            @default("active") @db.VarChar(20) // draft | active | paused | completed
  threads    OutreachThread[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([agencyId])
}

/// A rep's account on one platform, with their daily sending limits.
model SocialAccount {
  agencyId             String   @default("default")
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform             String   @db.VarChar(20)
  handle               String   @default("")
  dailyConnectionLimit Int      @default(20)
  dailyDmLimit         Int      @default(50)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([agencyId, userId, platform])
  @@index([agencyId])
}
