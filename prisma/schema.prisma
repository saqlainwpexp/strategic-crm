// Strategic CRM — Prisma schema (MySQL / Hostinger)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  SALES
  BD
  MANAGER
  SUPER_ADMIN
}

enum PipelineStage {
  LEAD
  CONTACTED
  INTERESTED
  MEETING_BOOKED
  SHOWED
  NO_SHOW
  NOT_INTERESTED
  HUNG_UP
  CALL_ME_LATER
  CLOSED_WON // Signed Up Client
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum MeetingType {
  DISCOVERY
  FOLLOW_UP
  PROPOSAL
  ONBOARDING
}

enum CallDisposition {
  CONNECTED
  NO_ANSWER
  VOICEMAIL
  BUSY
  WRONG_NUMBER
  INTERESTED
  NOT_INTERESTED
  CALL_ME_LATER
  MEETING_BOOKED
  HUNG_UP
}

enum MeetingStatus {
  BOOKED
  SHOWED
  NO_SHOW
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
  URL
}

// ─────────────────────────── Core ────────────────────────────

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(SALES)
  title        String  @default("")
  active       Boolean @default(true)
  avatarUrl    String?

  // Login security: lock the account briefly after repeated failed sign-ins.
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  // Hierarchy: Sales -> BD -> Manager
  reportsToId String?
  reportsTo   User?   @relation("Reports", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     User[]  @relation("Reports")

  leads     Lead[]      @relation("AssignedLeads")
  calls     CallLog[]
  meetings  Meeting[]
  payments  Payment[]
  timeLogs  TimeLog[]
  uploads   CsvImport[]
  auditLogs AuditLog[]
  scripts   Script[]
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportsToId])
  @@index([role])
}

model Pool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  leads       Lead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id                String        @id @default(cuid())
  businessName      String
  address           String?       @db.Text
  website           String?
  issues            String?       @db.Text
  suggestedServices String?       @db.Text
  phone             String?
  email             String?
  priority          LeadPriority  @default(MEDIUM)
  source            String?
  decisionMakerName String?
  city              String?
  leadScore         Int           @default(0) // 0-100; Cold/Warm/Hot is derived using Setting thresholds
  stage             PipelineStage @default(LEAD)
  service           String        @default("Web Design") // Web Design / Graphic Design / GHL
  estimatedValue    Decimal       @default(0) @db.Decimal(12, 2)
  notes             String?       @db.Text
  customFields      Json? // admin-defined extra fields, keyed by CustomFieldDef.key

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  poolId String?
  pool   Pool?   @relation(fields: [poolId], references: [id], onDelete: SetNull)

  calls    CallLog[]
  meetings Meeting[]
  payments Payment[]

  // Email marketing — leads double as email contacts.
  tags           Json? // string[] used to group contacts for campaigns and automations
  emailOptOut    Boolean                @default(false) // unsubscribed: never sent marketing email again
  unsubscribedAt DateTime?
  emailBouncedAt DateTime?
  lastEmailedAt  DateTime?
  handedOffAt    DateTime? // sent from email outreach to the calling team
  emailSends     EmailSend[]
  enrollments    AutomationEnrollment[]
  inboxThreads   InboxThread[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  closedAt        DateTime? // when the lead became a signed client

  @@index([assignedToId])
  @@index([poolId])
  @@index([stage])
  @@index([leadScore])
  @@index([priority])
  @@index([nextFollowUpAt])
  @@index([phone])
  @@index([email])
}

model CallLog {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime         @default(now())
  endedAt     DateTime?
  durationSec Int              @default(0)
  disposition CallDisposition?
  scriptId    String?
  script      Script?          @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([startedAt])
}

model Script {
  id          String    @id @default(cuid())
  title       String
  category    String?
  body        String    @db.Text
  active      Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  calls       CallLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Meeting {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        MeetingType   @default(DISCOVERY)
  scheduledAt DateTime
  durationMin Int           @default(30)
  status      MeetingStatus @default(BOOKED)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([scheduledAt])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceNo String        @unique
  leadId    String
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   String // Web Design / Graphic Design / GHL
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("PKR")
  status    PaymentStatus @default(PENDING)
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([leadId])
  @@index([status])
}

model TimeLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn     DateTime  @default(now())
  clockOut    DateTime?
  durationSec Int       @default(0)

  @@index([userId])
  @@index([clockIn])
}

model CustomFieldDef {
  id        String          @id @default(cuid())
  name      String // display label
  key       String          @unique // machine key used in Lead.customFields
  type      CustomFieldType @default(TEXT)
  options   Json? // for SELECT
  required  Boolean         @default(false)
  order     Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
}

model CsvImport {
  id             String   @id @default(cuid())
  fileName       String
  rowCount       Int      @default(0)
  successCount   Int      @default(0)
  duplicateCount Int      @default(0)
  errorCount     Int      @default(0)
  poolId         String?
  status         String   @default("completed")
  mapping        Json?
  errors         Json?
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────── Email marketing ──────────────────────

enum EmailAccountStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  SENT
  CANCELLED
}

enum SendStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

enum MessageDirection {
  IN
  OUT
}

/// A mailbox we send from (SMTP) and read replies from (IMAP). The password is AES-GCM encrypted.
model EmailAccount {
  id          String             @id @default(cuid())
  name        String
  email       String             @unique
  fromName    String
  provider    String             @default("Custom")
  smtpHost    String
  smtpPort    Int                @default(465)
  smtpSecure  Boolean            @default(true)
  smtpUser    String
  passwordEnc String             @db.Text
  imapEnabled Boolean            @default(true)
  imapHost    String             @default("")
  imapPort    Int                @default(993)
  imapSecure  Boolean            @default(true)
  dailyLimit  Int                @default(150)
  minDelaySec Int                @default(60) // gap between two sends from this mailbox
  signature   String             @default("") @db.Text
  status      EmailAccountStatus @default(PENDING)
  lastError   String?            @db.Text
  sentToday   Int                @default(0)
  sentDay     String             @default("") // YYYY-MM-DD the counter belongs to
  lastSentAt  DateTime?
  lastSyncAt  DateTime?
  lastUid     Int                @default(0) // highest IMAP UID already imported
  uidValidity String?
  sends       EmailSend[]
  threads     InboxThread[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model EmailDomain {
  id            String    @id @default(cuid())
  domain        String    @unique
  spfStatus     String    @default("pending")
  dkimStatus    String    @default("pending")
  dmarcStatus   String    @default("pending")
  details       Json?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String   @default("")
  html      String   @db.MediumText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  subject        String         @default("")
  previewText    String         @default("")
  html           String         @db.MediumText
  fromName       String         @default("")
  replyTo        String         @default("")
  accountIds     Json // string[] — sends rotate across these mailboxes
  audience       Json // AudienceFilter (see src/lib/email.ts)
  trackOpens     Boolean        @default(true)
  trackClicks    Boolean        @default(true)
  addUnsubscribe Boolean        @default(true)
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  recipientCount Int            @default(0)
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sends          EmailSend[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

/// One outgoing email (a campaign recipient or an automation step) and what happened to it.
model EmailSend {
  id           String        @id @default(cuid())
  campaignId   String?
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  automationId String?
  automation   Automation?   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  stepIndex    Int?
  nodeId       String?
  leadId       String?
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  email        String
  accountId    String?
  account      EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status       SendStatus    @default(QUEUED)
  subject      String        @default("") @db.VarChar(500)
  messageId    String?       @db.VarChar(255)
  error        String?       @db.Text
  claimedAt    DateTime?
  queuedAt     DateTime      @default(now())
  sentAt       DateTime?
  openedAt     DateTime?
  openCount    Int           @default(0)
  clickedAt    DateTime?
  clickCount   Int           @default(0)
  repliedAt    DateTime?
  bouncedAt    DateTime?

  @@unique([campaignId, leadId])
  @@index([status, queuedAt])
  @@index([leadId])
  @@index([automationId])
  @@index([sentAt])
  @@index([messageId])
}

model Automation {
  id           String                 @id @default(cuid())
  name         String
  trigger      String                 @default("MANUAL") // MANUAL | LEAD_CREATED | STAGE_CHANGED | TAG_ADDED
  triggerValue String                 @default("")
  flow         Json                   @map("steps") // Flow graph (see src/lib/automation-flow.ts)
  accountIds   Json // string[]
  stopOnReply  Boolean                @default(true)
  status       AutomationStatus       @default(DRAFT)
  enrollments  AutomationEnrollment[]
  sends        EmailSend[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model AutomationEnrollment {
  id           String           @id @default(cuid())
  automationId String
  automation   Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepIndex    Int              @default(0)
  nodeId       String? // workflow node to run next (null = first step after the trigger)
  nextRunAt    DateTime?
  status       EnrollmentStatus @default(ACTIVE)
  stopReason   String?
  enrolledAt   DateTime         @default(now())
  finishedAt   DateTime?

  @@unique([automationId, leadId])
  @@index([status, nextRunAt])
}

model InboxThread {
  id            String         @id @default(cuid())
  accountId     String
  account       EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  subject       String         @db.VarChar(500)
  contactEmail  String
  contactName   String         @default("")
  unread        Boolean        @default(true)
  archived      Boolean        @default(false)
  lastMessageAt DateTime
  messages      InboxMessage[]
  createdAt     DateTime       @default(now())

  @@index([accountId, lastMessageAt])
  @@index([contactEmail])
}

model InboxMessage {
  id         String           @id @default(cuid())
  threadId   String
  thread     InboxThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  accountId  String
  messageId  String           @db.VarChar(255)
  inReplyTo  String?          @db.VarChar(255)
  references String?          @db.Text
  direction  MessageDirection
  fromEmail  String
  fromName   String           @default("")
  toEmail    String           @default("")
  subject    String           @db.VarChar(500)
  text       String           @db.MediumText
  sentAt     DateTime
  createdAt  DateTime         @default(now())

  @@unique([accountId, messageId])
  @@index([threadId, sentAt])
}
