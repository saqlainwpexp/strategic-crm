# ─── Database (Hostinger MySQL) ───────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
# On Hostinger: create a MySQL DB in hPanel → use "localhost" as host if the
# Node app runs on the same server, otherwise the remote MySQL host they give you.
DATABASE_URL="mysql://root:password@localhost:3306/strategic_crm"

# ─── NextAuth ─────────────────────────────────────────────────
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── App settings ─────────────────────────────────────────────
# Display currency and timezone are set in Admin → Branding.

# ─── Email marketing ──────────────────────────────────────────
# Encrypts mailbox (SMTP/IMAP) passwords in the database. Generate once and use the
# SAME value everywhere that shares this database (your PC and Hostinger).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# Optional: lets a cron job wake the email engine (GET /api/e/cron?key=...).
# CRON_SECRET="another-long-random-string"

# Optional: set to "off" to stop this copy of the app sending email
# (e.g. on your PC while the live site does the sending).
# EMAIL_WORKER="off"

# Public agency signup uses DATABASE_URL; tenant identity comes from signed sessions.
